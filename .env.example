# Copy to .env.local for development. Never commit real values.
# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix.

# development | staging | production
APP_ENV=development
# Public origin used for invitation and email-confirmation links
APP_ORIGIN=http://localhost:3000

# Supabase (from `supabase status` locally, or the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — bypasses RLS. Server only. In Cloudflare: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env <env>`
SUPABASE_SERVICE_ROLE_KEY=

# Platform domain for tenant subdomains (decision D7), e.g. rentals.example.com
PLATFORM_ROOT_DOMAIN=
# Development only: tenant slug used when the Host doesn't match a domain (e.g. acme). Rejected in production.
DEV_TENANT_SLUG=acme

# Google Maps Platform (Routes API) for road-distance delivery pricing. SECRET, server only.
# Without it, mileage delivery returns manual review.
GOOGLE_MAPS_API_KEY=

# AI assistant (M7, ADR 0017). SECRET, server only — never NEXT_PUBLIC_.
# Without a key (and without AI_PROVIDER) the assistant is not offered.
OPENAI_API_KEY=
# openai | scripted (deterministic test double, rejected in production) | off
AI_PROVIDER=
# Optional overrides of src/server/ai/config.ts defaults.
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
# Width-bounded storefront images via Supabase image transformations (ADR 0016 §13): on | off
STOREFRONT_IMAGE_TRANSFORMS=off
