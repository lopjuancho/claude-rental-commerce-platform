{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = the development Worker. Production and staging are only ever deployed with an
  // explicit --env (scripts/deploy.sh; tests/unit/deploy-config.test.ts pins all of this).
  "name": "rental-commerce-development",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rental-commerce-development" }],
  "observability": { "enabled": true },
  // Non-secret vars only. Secrets (SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY) are set with
  // `wrangler secret put --env <env>`, never committed. Bindings are NOT inherited by
  // environments, so each environment repeats them. Namespace ids must be unique per env.
  "vars": { "APP_ENV": "development" },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "ASSISTANT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "PUBLIC_QUERY_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "ASSISTANT_SESSION_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
  "env": {
    "staging": {
      "name": "rental-commerce-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rental-commerce-staging" }],
      "vars": { "APP_ENV": "staging" },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PUBLIC_WRITE_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "ASSISTANT_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "PUBLIC_QUERY_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "ASSISTANT_SESSION_RATE_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 12, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "claude-rental-commerce-platform",
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "claude-rental-commerce-platform" },
      ],
      "vars": { "APP_ENV": "production" },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PUBLIC_WRITE_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "ASSISTANT_RATE_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "PUBLIC_QUERY_RATE_LIMITER",
          "namespace_id": "3004",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "ASSISTANT_SESSION_RATE_LIMITER",
          "namespace_id": "3005",
          "simple": { "limit": 12, "period": 60 },
        },
      ],
    },
  },
}
